{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.glavo.site/hmcl/announcements/1.0.0",
  "title": "HMCL Announcement Feed",
  "description": "A complete list of announcements with localized Markdown content.",
  "type": "array",
  "items": {
    "$ref": "#/$defs/announcement"
  },
  "$defs": {
    "announcementId": {
      "type": "string",
      "description": "A permanent, canonical lowercase UUID v7 identifier.",
      "minLength": 36,
      "maxLength": 36,
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "nonEmptyString": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "localizedText": {
      "description": "Locale-independent text or localized text with a mandatory fallback.",
      "oneOf": [
        {
          "$ref": "#/$defs/nonEmptyString"
        },
        {
          "type": "object",
          "required": ["default"],
          "properties": {
            "default": {
              "$ref": "#/$defs/nonEmptyString"
            }
          },
          "propertyNames": {
            "pattern": "^(default|[A-Za-z]{2,8}(-[A-Za-z0-9]{1,8})*)$"
          },
          "additionalProperties": {
            "$ref": "#/$defs/nonEmptyString"
          }
        }
      ]
    },
    "httpsUrl": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://[^/?#\\s@]+(?:[/?#][^\\s]*)?$",
      "description": "An absolute HTTPS URL. Host and user-information constraints require URI parsing."
    },
    "localizedUrl": {
      "oneOf": [
        {
          "$ref": "#/$defs/httpsUrl"
        },
        {
          "type": "object",
          "required": ["default"],
          "properties": {
            "default": {
              "$ref": "#/$defs/httpsUrl"
            }
          },
          "propertyNames": {
            "pattern": "^(default|[A-Za-z]{2,8}(-[A-Za-z0-9]{1,8})*)$"
          },
          "additionalProperties": {
            "$ref": "#/$defs/httpsUrl"
          }
        }
      ]
    },
    "announcement": {
      "type": "object",
      "required": ["id", "type", "title", "content"],
      "properties": {
        "id": {
          "$ref": "#/$defs/announcementId"
        },
        "type": {
          "type": "string",
          "enum": ["board", "popup"],
          "description": "The presentation surface. It must remain unchanged for an existing ID."
        },
        "title": {
          "$ref": "#/$defs/localizedText",
          "description": "A plain-text title. Markdown and HTML are not interpreted."
        },
        "content": {
          "$ref": "#/$defs/localizedText",
          "description": "Localized CommonMark 0.31.2 text without extensions."
        },
        "priority": {
          "type": "integer",
          "minimum": -2147483648,
          "maximum": 2147483647,
          "default": 0,
          "description": "Higher values appear first within the same presentation surface."
        },
        "severity": {
          "type": "string",
          "enum": ["info", "warning", "critical"],
          "default": "info",
          "description": "Visual importance. It does not change dismissal behavior."
        },
        "requiresShown": {
          "$ref": "#/$defs/announcementId",
          "description": "The ID of an announcement that must have been shown to the user before this announcement can be displayed. The referenced announcement may use either presentation type and need not be in the current feed."
        },
        "url": {
          "$ref": "#/$defs/localizedUrl",
          "description": "An optional detail page opened only after a user action."
        },
        "expiresAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-5][0-9]Z$",
          "description": "The exclusive UTC end of the display interval, at whole-second precision."
        }
      },
      "additionalProperties": true
    }
  }
}
